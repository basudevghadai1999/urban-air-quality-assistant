# Copy to .env.local (never commit real values: .env* is git-ignored except this file).
# Every variable here is read on the SERVER only. Never give any of them a NEXT_PUBLIC_ prefix.
# Leave a value blank (or commented out) to use the documented default.

# ---------------------------------------------------------------------------
# Gemini (explains the deterministic recommendations; never calculates anything)
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# GEMINI_KEY is also accepted as a fallback name; GEMINI_API_KEY wins if both are set.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.5-flash)
# GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Groq (secondary explanation provider, used only when Gemini fails or is not set up)
# ---------------------------------------------------------------------------
# Get a key at https://console.groq.com/keys. Server-side only; never prefix it NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional: override the Groq model (default: openai/gpt-oss-20b, a Groq production model
# with strict JSON-schema output). See docs/AI_PROVIDER_ARCHITECTURE.md before changing it.
# GROQ_MODEL=

# ---------------------------------------------------------------------------
# Air quality data (Open-Meteo needs no API key)
# ---------------------------------------------------------------------------
# How long a fetched reading counts as fresh, in seconds. Default 900 (15 minutes). Range 60-3600.
# AIR_CACHE_TTL_SECONDS=

# Optional tuning (defaults shown):
# AIR_MAX_STALE_SECONDS=86400          # oldest reading still shown, marked stale, if the provider is down
# AIR_FAILURE_BACKOFF_SECONDS=60       # pause before calling a failing provider again
# AIR_UPSTREAM_TIMEOUT_MS=8000         # provider request timeout

# ---------------------------------------------------------------------------
# Persistent cache and rate limiting: Upstash Redis (REST)
# ---------------------------------------------------------------------------
# Create a database at https://console.upstash.com/ and copy its REST URL and token.
# Both must be set together. Without them the app runs, but last-known-good data is kept
# only in each server instance's memory and rate limiting is per instance (fine for local
# development; degraded in production: responses then report cache.degraded = true).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Per-client rate limit for GET /api/air. Defaults: 30 requests per 60 seconds.
# AIR_RATE_LIMIT_MAX=
# AIR_RATE_LIMIT_WINDOW_SECONDS=

# ---------------------------------------------------------------------------
# Client identity for per-client rate limits (Render)
# ---------------------------------------------------------------------------
# Set to "true" ONLY on a Render web service. Render's Cloudflare layer writes CF-Connecting-IP and
# overwrites any value the caller sent; the app then keys limits on that single address. X-Forwarded-For
# and every other forwarding header are never trusted. Anywhere else (local development, any other
# host, or unset) no header is trusted and all clients share one rate-limit bucket.
# TRUST_RENDER_CF_CONNECTING_IP=true

# ---------------------------------------------------------------------------
# Gemini explanation limits (POST /api/recommend with "explain": true)
# ---------------------------------------------------------------------------
# Cache hits and fallbacks never count against these. Production needs Redis for them to be enforced;
# without it AI explanations are paused (the deterministic result is still returned).
# AI_EXPLANATIONS_ENABLED=true            # false switches Gemini off entirely
# AI_RATE_LIMIT_MAX=                      # per-client generations per window. Default 5 (shared name with the air limit)
# AI_PROVIDER_ORDER=gemini,groq           # providers to try, in order. Unconfigured providers are skipped. Default gemini,groq
# AI_DAILY_BUDGET=                        # GLOBAL provider calls (attempts) per UTC day, all providers together. Default 300 (render.yaml sets 100 for free quotas)
# AI_GEMINI_DAILY_BUDGET=                 # Gemini calls per UTC day. Default 200
# AI_GROQ_DAILY_BUDGET=                   # Groq calls per UTC day. Default 200
# AI_REQUEST_TIMEOUT_MS=                  # default 20000
# AI_MAX_OUTPUT_TOKENS=                   # default 3000
# AI_THINKING_BUDGET=                     # default: 0 for gemini-2.5-flash models, the model default otherwise
# AI_CACHE_TTL_SECONDS=                   # validated-explanation cache, default 1800
